@startuml
skinparam componentStyle uml2

' --- 1. PRESENTATION TIER ---
package "Presentation Tier (Frontend)" {
    [React.js App] as Client
    note right of Client
        - Login/Register UI
        - Dashboard & Key Mgmt
        - API Explorer
    end note
}

' --- 2. APPLICATION TIER ---
package "Application Tier (Backend)" {
    [Node.js + Express] as Server
    
    component "Middleware" {
        [JWT Auth]
        [API Key Check]
    }
    
    component "Business Logic" {
        [Sniper Logic (Gacha)]
        [External API Integrator] 
    }
    
    Server ..> [JWT Auth]
    Server ..> [Sniper Logic (Gacha)]
}

' --- 3. DATA TIER ---
package "Data Tier (Database)" {
    database "MySQL" {
        [Users Table]
        [API Keys Table]
    }
}

' --- 4. EXTERNAL TIER (INI YANG BARU) ---
cloud "External Services (Internet)" {
    [WeatherAPI.com] as Weather
    [Frankfurter API] as Rates
}

' RELASI
Client <--> Server : JSON / HTTP REST
Server <--> MySQL : SQL Queries

' Relasi ke Luar (PENTING)
[External API Integrator] --> Weather : Fetch Data Cuaca
[External API Integrator] --> Rates : Fetch Data Kurs

@enduml