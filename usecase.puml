@startuml
skinparam componentStyle uml2

' --- 1. PRESENTATION TIER ---
package "1. Presentation Tier (Frontend)" {
    [React App (Browser)] as Client
    note bottom of Client
        User Interface
        (Input Kota, Dashboard)
    end note
}

' --- 2. LOGIC TIER ---
package "2. Logic Tier (Backend)" {
    [Express Server] as Server
    [Sniper Engine] as Engine
    [Auth Middleware] as Auth
    
    Server --> Auth : Cek Token/Key
    Server --> Engine : Process Data
}

' --- 3. DATA TIER ---
package "3. Data Tier (Database)" {
    database "MySQL" as DB
}

' --- EKSTERNAL (Bukan Tier Utama, tapi pendukung) ---
cloud "External APIs" {
    [WeatherAPI (Cuaca)] as Weather
    [Frankfurter (Kurs)] as Rates
}

' RELASI ANTAR TIER
Client <--> Server : HTTP / REST API
Auth <--> DB : Read User/Key
Engine <--> Weather : Axios Get
Engine <--> Rates : Axios Get
Engine --> DB : Update Hits (+1)

@enduml